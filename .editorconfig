# Codifies the conventions the repo already follows.
#
# shfmt reads this file (mvdan.cc/editorconfig), so the formatter's settings and
# the editor's stay in agreement by construction rather than by memory — there
# are no shfmt flags in the Makefile to drift out of sync with these values.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Two matchers, not one: SHELL_FILES in the Makefile discovers scripts by
# shebang, and scripts/buffer is bash with no extension. A `*.{sh,bash}` glob
# alone silently misses it, and shfmt then falls back to its own defaults —
# tabs — for exactly the file this repo says is 2-space. Keep both in sync.
[*.{sh,bash}]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
space_redirects = false

[scripts/**]
indent_style = space
indent_size = 2

# shfmt-specific keys below.
#
# switch_case_indent matches how every `case` in scripts/ is already written.
# binary_next_line matches the existing `... ||` continuation style.
#
# space_redirects stays false — `>file`, not `> file`. Neither value matches the
# repo perfectly: shfmt applies one rule to both plain redirects (written `> f`
# here) and fd redirects (written `2>/dev/null` here), and cannot tell them
# apart. false leaves the far more common `2>/dev/null` alone.
switch_case_indent = true
binary_next_line = true
space_redirects = false

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Two posts predate insert_final_newline and deliberately end without one.
# Rewriting them would show up as a content change in `git log` for no reason —
# scripts/record-promotion.sh goes out of its way to preserve exactly this.
[content/**.md]
insert_final_newline = false
trim_trailing_whitespace = false
