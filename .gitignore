# Hugo default output directory
/public

## OS Files
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# OSX
.DS_Store

# **/themes/
resources
demo/
.hugo/*
!.hugo/version

# Local Netlify folder
.netlify

# Obsidian
.obsidian/

# Hugo
.hugo_build.lock

# Lighthouse CI local run output
.lighthouseci/

# Node
node_modules/

# Agentic programming
tmp/!CLAUDE.md
!CLAUDE.md
.omc

# Track repo-committed Claude config (overrides global .gitignore_global .claude/* rule)
!.claude/settings.json
!.claude/skills/
!.claude/skills/**
!.claude/commands/
!.claude/commands/*.md

# Vale styles: commit our own rules under styles/Slop/ and styles/config/,
# ignore third-party packages fetched via `vale sync`.
styles/*
!styles/Slop/
!styles/Slop/**
!styles/config/
!styles/config/**

# .mcp.json is committed: every server MUST use op:// references, never literal secrets.
!.mcp.json

# Things3 Task Migration
.migration/

# Newsletter sidecar briefs (raw aggregation data, not for committing)
content/newsletter/the-unwind/.brief-*.md

# Claude Code agent worktrees (session-local checkouts)
.claude/worktrees/

# Build caches. Hugo's own caches live under resources/ (already ignored above);
# this covers the paths netlify.toml's cache plugin restores into the tree.
.cache/

# Transitional: .tools/ held the pre-mise ensure-tool.sh binaries. Keep the
# entry one cycle so existing checkouts do not show them as untracked noise;
# then delete it (and `rm -rf .tools` on machines that still have it).
.tools/

# mise local override file (uncommitted per-machine tweaks).
mise.local.toml

# lychee link-check result cache (`make links-external`).
.lycheecache
